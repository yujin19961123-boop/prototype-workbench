{
  "name": "company-prototype",
  "private": true,
  "version": "0.1.0-preview.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "typecheck": "tsc --noEmit",
    "tokens:generate": "node --experimental-strip-types scripts/build-tokens.ts",
    "tokens:check": "node --experimental-strip-types scripts/build-tokens.ts --check",
    "design:check": "node --experimental-strip-types scripts/check-design-baseline.ts",
    "check:catalog": "node --experimental-strip-types scripts/check-catalog.ts",
    "check:composition": "node scripts/check-composition.cjs",
    "check:im-foundation": "node --experimental-strip-types scripts/check-starter-im.mjs",
    "workbench:upgrade": "node scripts/upgrade-workbench.mjs",
    "build": "npm run tokens:check && npm run design:check && npm run check:catalog && npm run check:composition && npm run check:im-foundation && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lottie-web": "5.13.0",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "use-intl": "4.14.9",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@babel/parser": "7.29.12",
    "@babel/traverse": "7.29.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "8.5.32",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@babel/generator": "7.29.12"
  }
}
